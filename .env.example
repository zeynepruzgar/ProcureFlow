# ============================================================
# ProcureFlow - ornek ortam degiskenleri
# Bu dosyayi .env olarak kopyalayin ve degerleri doldurun.
# .env dosyasi git'e commit EDILMEZ (bkz. .gitignore).
# ============================================================

# ---- Supabase ----
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Postgres baglantisi (LangGraph checkpointer ve migration'lar icin)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
# Web uygulamasinin CORS icin izinli origin'i
CORS_ALLOW_ORIGINS=http://localhost:3000

# ---- LLM (saglayici-bagimsiz; bkz. docs/AGENT.md) ----
# provider: ollama | openai | anthropic | groq
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
OLLAMA_URL=http://localhost:11434
# Hosted'a gecerken (ornek):
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5-nano
# OPENAI_API_KEY=sk-...

# ---- Web (Next.js) ----
# NEXT_PUBLIC_* degiskenleri tarayiciya acilir; sir koymayin.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000
